mutate(
Media_Emisiones = round(Media_Emisiones, 2)
)
# Instalando pacman si se requier
if (!require("pacman")) install.packages("pacman")
# Cargando los paquetes usando pacman
pacman::p_load(
# A) Manipulación, limpieza y visualización de datos
tidyverse,    # Colección de paquetes esenciales (incluye dplyr, ggplot2, etc.)
forcats,      # Herramientas para trabajar con variables categóricas (factores).
tibble,       # Implementación moderna de data.frames.
janitor,      # Limpieza de nombres de variables y tablas de frecuencia.
lubridate,    # Manejo avanzado de fechas y horas.
skimr,        # Resúmenes estadísticos completos y rápidos de data.frames.
stringi,      # Manipulación robusta de texto (strings).
scales,       # Formato de escalas en ggplot2 (ej. porcentajes, comas).
openxlsx,     # Guardar excel
writexl,      # Guardar excel
# B) Modelado y análisis estadístico/econométrico
fixest,       # Estimación de modelos de efectos fijos de alto rendimiento.
plm,          # Modelos econométricos para datos de panel.
AER,          # Herramientas para econometría aplicada (ej. variables instrumentales).
lmtest,       # Pruebas de hipótesis para modelos de regresión (ej. coeftest).
sandwich,     # Cálculo de errores estándar robustos a heterocedasticidad.
survey,       # Análisis de datos de encuestas complejas (ponderación, estratificación)
boot,
# C) Importación, exportación y generación de reportes
haven,        # Lectura y escritura de formatos de Stata, SAS y SPSS.
readxl,       # Lectura de archivos de Excel (.xls y .xlsx).
stargazer,    # Creación de tablas de regresión con formato de publicación.
knitr,        # Generación de reportes dinámicos.
kableExtra,
webshot,
)
# Paso 0. Diferencia promedio
dif_media <- mean(d1$co2_2023, na.rm = TRUE) - mean(d2$co2_2023, na.rm = TRUE)
#Estadísticas de cada grupo
resultados_pib <- bind_rows(
d1 %>% summarise(
Grupo = "Alto PIB per cápita",
Media_Emisiones = mean(co2_2023, na.rm = TRUE),
N = n()
),
d2 %>% summarise(
Grupo = "Bajo PIB per cápita",
Media_Emisiones = mean(co2_2023, na.rm = TRUE),
N = n()
)
)
#Calculamos las medias de cada grupo y su diferencia
media_alto <- resultados_pib %>% filter(Grupo == "Alto PIB per cápita") %>% pull(Media_Emisiones)
media_bajo <- resultados_pib %>% filter(Grupo == "Bajo PIB per cápita") %>% pull(Media_Emisiones)
diferencia_observada <- media_alto - media_bajo
#Tabulamos
diferencia_fila <- data.frame(
Grupo = "Diferencia (Alto - Bajo)",
Media_Emisiones = diferencia_observada,
N = NA # N/A para la diferencia de medias
)
tabla_resultados <- bind_rows(resultados_pib, diferencia_fila) %>%
mutate(
Media_Emisiones = round(Media_Emisiones, 2)
)
tabla_diferencia <- tabla_resultados %>%
kbl(
caption = "Tabla 3. Diferencia Promedio de Emisiones de CO₂ per Cápita (t CO₂/persona)",
align = "lcc",
booktabs = TRUE,
digits = 2,
col.names = c("Grupo de PIB", "Media de Emisiones", "N (Observaciones)"),
row.names = FALSE
) %>%
kable_classic(
full_width = FALSE,
html_font = "Times New Roman"
) %>%
save_kable("Graficos/tabla3_media_CO2_altos_y_bajos.html")
#Procedimiento Bootstrap
datos_combinados <- bind_rows(
d1 %>% mutate(grupo = 1),  # 1 = Alto PIB
d2 %>% mutate(grupo = 0)   # 0 = Bajo PIB
) %>%
filter(!is.na(co2_2023))
#Creación de la función
diferencia_boot <- function(data, indices) {
datos_b <- data[indices, ]
media_alto <- datos_b %>%
filter(grupo == 1) %>%
summarise(mean(co2_2023)) %>%
pull()
media_bajo <- datos_b %>%
filter(grupo == 0) %>%
summarise(mean(co2_2023)) %>%
pull()
return(media_alto - media_bajo)
}
#Ejecución del remuestreo
set.seed(12345)
B <- 1000
boot_resultados <- boot(
data = datos_combinados,
statistic = diferencia_boot,
R = B
)
#Calculamos el IC
ic_bootstrap_bca <- boot.ci(boot_resultados, type = "bca", conf = 0.95)
#Tabulamos
limite_inferior_boot <- ic_bootstrap_bca$bca[4]
limite_superior_boot <- ic_bootstrap_bca$bca[5]
ic_formato_boot <- sprintf(
"[%.3f ; %.3f]",
limite_inferior_boot,
limite_superior_boot
)
tabla_ic_boot <- data.frame(
Método = "Bootstrap BCa (95%)",
Estimación_Puntual = round(diferencia_observada, 3),
Intervalo_Confianza = ic_formato_boot
)
tabla_final_boot <- tabla_ic_boot %>%
kbl(
caption = "Tabla 4. Estimación e Intervalo de Confianza Bootstrap BCa (Alto PIB - Bajo PIB)",
align = "lcc",
booktabs = TRUE,
digits = 3,
col.names = c("Método", "Diferencia Media (t CO₂/persona)", "IC 95% (t CO₂/persona)"),
row.names = FALSE
) %>%
kable_classic(
full_width = FALSE,
html_font = "Times New Roman"
)
#Prueba t (Welch)
prueba_t <- t.test(
co2_2023 ~ grupo,
data = datos_combinados,
conf.level = 0.95,
var.equal = FALSE
)
#Invertimos el orden
ic_t <- -prueba_t$conf.int[2:1]
limite_inferior_t <- ic_t[1]
limite_superior_t <- ic_t[2]
#Tabulacion
ic_t_formato <- sprintf("[%.3f ; %.3f]", limite_inferior_t, limite_superior_t)
ic_formato_boot <- sprintf("[%.3f ; %.3f]", limite_inferior_boot, limite_superior_boot)
tabla_comparativa <- data.frame(
Método = c("Muestra Original", "Prueba t de Welch (95%)", "Bootstrap BCa (95%)"),
Estimacion_Puntual = c(round(diferencia_observada, 3), round(diferencia_observada, 3), round(diferencia_observada, 3)),
Intervalo_Confianza = c("N/A", ic_t_formato, ic_formato_boot)
) %>%
rename(
Diferencia_Media = Estimacion_Puntual,
IC_95_porciento = Intervalo_Confianza
)
#Tabulamos la comparación
tabla_final<- tabla_comparativa %>%
kbl(
caption = "Tabla 5. Comparación de Estimación Puntual e Intervalos de Confianza (IC) para la Diferencia de Emisiones",
align = "lcc",
booktabs = TRUE,
col.names = c("Método", "Diferencia Media (t CO₂/persona)", "IC 95%"),
row.names = FALSE,
digits = 3
) %>%
kable_classic(
full_width = FALSE,
html_font = "Times New Roman"
) %>%
row_spec(1, bold = TRUE, background = "#F0F0F0") %>%
kable_styling(
bootstrap_options = c("striped", "hover"),
full_width = F,
position = "center"
)
#Creamos dataframe con resultados
