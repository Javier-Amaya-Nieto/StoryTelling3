IC_95 = c(
paste(round(t_test_res$conf.int[1], 2), "–", round(t_test_res$conf.int[2], 2)),
paste(round(ci_diff$bca[4], 2), "–", round(ci_diff$bca[5], 2))
),
p_valor = c(round(t_test_res$p.value, 4), "No aplica")
)
tabla_comp %>%
kbl(
caption = "Comparación entre Bootstrap y prueba t para la diferencia de emisiones (t CO₂/persona)",
align = "lccc",
booktabs = TRUE
) %>%
kable_classic(full_width = FALSE, html_font = "Times New Roman") %>%
save_kable("Graficos/tabla_comp.html")
cat("\n✅ El intervalo de confianza NO incluye el valor 0, por lo que se rechaza H₀.")
cat("\n✅ El p-valor es prácticamente 0, indicando evidencia fuerte de que los países con alto PIB per cápita emiten significativamente más CO₂ per cápita.\n")
cat("✅ Tanto la prueba t como el método bootstrap conducen a la misma conclusión.\n")
# Paso 7. Gráfico comparativo de estimaciones e intervalos
# Crear tabla con resultados para graficar
resultados_plot <- tibble::tibble(
Metodo = c("Bootstrap BCa (95%)", "Prueba t (95%)"),
Estimacion = c(mean(boot_diff_res$t), t_test_res$estimate[1] - t_test_res$estimate[2]),
IC_inf = c(ci_diff$bca[4], t_test_res$conf.int[1]),
IC_sup = c(ci_diff$bca[5], t_test_res$conf.int[2])
)
# Gráfico tipo forest plot
g5 <- ggplot(resultados_plot, aes(x = Metodo, y = Estimacion)) +
geom_point(size = 3, color = "#003366") +
geom_errorbar(aes(ymin = IC_inf, ymax = IC_sup),
width = 0.2, color = "#003366", size = 1) +
coord_flip() +
geom_hline(yintercept = 0, linetype = "dashed", color = "gray40") +
theme_minimal(base_size = 13, base_family = "Helvetica") +
theme(
panel.grid = element_blank(),
plot.title = element_text(face = "bold", color = "#003366", size = 14),
axis.title = element_text(face = "bold", color = "#003366"),
axis.text = element_text(color = "gray20")
) +
labs(
title = "Comparación de estimaciones e intervalos de confianza (2023)",
subtitle = "Diferencia de medias de CO₂ per cápita: PIB alto - PIB bajo",
y = "Diferencia estimada (toneladas por persona)",
x = NULL
)
# Guardar gráfico
ggsave("Graficos/g5.png", g_forest, width = 8, height = 6, dpi = 300)
